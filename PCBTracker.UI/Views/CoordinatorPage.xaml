<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PCBTracker.UI.Views.CoordinatorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PCBTracker.UI.ViewModels"
    x:Name="CoordinatorPageRoot"
    Title="Coordinator"
    BackgroundColor="#F4F7FA">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sync" Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="HeaderCell" TargetType="Label">
            <Setter Property="TextColor" Value="#334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="BodyCell" TargetType="Label">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="PlaceholderColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="TitleColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="14">
        <Border Grid.Row="0" Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,280,240" ColumnSpacing="14">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Coordinator" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="{Binding LastSyncLabel}" TextColor="#64748B" />
                    <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Search" Style="{StaticResource FieldLabel}" />
                    <Entry
                        Placeholder="Search order #, inventory, PO"
                        Text="{Binding SearchText}"
                        ClearButtonVisibility="WhileEditing" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="6">
                    <Label Text="Processing Status" Style="{StaticResource FieldLabel}" />
                    <Picker
                        ItemsSource="{Binding ProcessingStatusOptions}"
                        SelectedItem="{Binding SelectedProcessingStatusFilter}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">

            <Border Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <ScrollView Orientation="Horizontal">
                    <CollectionView
                        ItemsSource="{Binding Orders}"
                        WidthRequest="1380"
                        HorizontalOptions="FillAndExpand">

                        <CollectionView.EmptyView>
                            <Label Text="No orders found." Padding="14" TextColor="#64748B" />
                        </CollectionView.EmptyView>

                        <CollectionView.Header>
                            <Grid Padding="12,10" ColumnDefinitions="160,330,90,90,150,130,130,130,230" ColumnSpacing="12" BackgroundColor="#EAF0F6">
                                <Label Text="Order # / Status" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="1" Text="Inventory ID" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="2" Text="Order Qty" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="3" Text="Open Qty" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="4" Text="PO" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="5" Text="Request Date" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="6" Text="Processing" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="7" Text="Updated" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="8" Text="Change / Confirm" Style="{StaticResource HeaderCell}" HorizontalTextAlignment="Center" />
                            </Grid>
                        </CollectionView.Header>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" ColumnDefinitions="160,330,90,90,150,130,130,130,230" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding OrderNbr}" FontAttributes="Bold" TextColor="#0F172A" FontSize="13" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Status}" TextColor="#64748B" FontSize="11" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="{Binding InventoryId}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="2" Text="{Binding OrderQty, StringFormat='{}{0:0.##}'}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="3" Text="{Binding OpenQty, StringFormat='{}{0:0.##}'}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="4" Text="{Binding CustomerOrderNbr}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="5" Text="{Binding RequestDate, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="6" Text="{Binding ProcessingStatus}" TextColor="#0F766E" FontAttributes="Bold" FontSize="12" />
                                    <Label Grid.Column="7" Text="{Binding LastUpdatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" TextColor="#64748B" FontSize="12" />

                                    <HorizontalStackLayout Grid.Column="8" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Picker
                                            ItemsSource="{Binding BindingContext.RowProcessingStatusOptions, Source={x:Reference CoordinatorPageRoot}}"
                                            SelectedItem="{Binding ProcessingStatus}"
                                            WidthRequest="120" />
                                        <Button
                                            Text="Confirm"
                                            Padding="10,4"
                                            MinimumHeightRequest="34"
                                            MinimumWidthRequest="80"
                                            BackgroundColor="#0F766E"
                                            TextColor="#FFFFFF"
                                            Command="{Binding BindingContext.ConfirmProcessingStatusCommand, Source={x:Reference CoordinatorPageRoot}}"
                                            CommandParameter="{Binding}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
            </Border>
        </RefreshView>
    </Grid>
</ContentPage>
