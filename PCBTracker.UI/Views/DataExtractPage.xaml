<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:PCBTracker.Domain.DTOs;assembly=PCBTracker.Domain"
    x:Class="PCBTracker.UI.Views.DataExtractPage"
    Title="Extract"
    BackgroundColor="#F4F7FA">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="HeaderCell" TargetType="Label">
            <Setter Property="TextColor" Value="#334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="BodyCell" TargetType="Label">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="PlaceholderColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
            <Setter Property="MinimumHeightRequest" Value="42" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="#334155" />
                                <Setter Property="PlaceholderColor" Value="#64748B" />
                                <Setter Property="BackgroundColor" Value="#EEF2F7" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="TitleColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
            <Setter Property="MinimumHeightRequest" Value="42" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="#334155" />
                                <Setter Property="TitleColor" Value="#64748B" />
                                <Setter Property="BackgroundColor" Value="#EEF2F7" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
            <Setter Property="MinimumHeightRequest" Value="42" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="#334155" />
                                <Setter Property="BackgroundColor" Value="#EEF2F7" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Border
            Grid.Row="0"
            Padding="16"
            Stroke="#D8E0EA"
            StrokeThickness="1"
            BackgroundColor="#FFFFFF">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Extract Boards"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />
                    <Label
                        Text="{Binding DateModeLabel}"
                        TextColor="#64748B" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Label
                        Text="{Binding TotalCountLabel}"
                        FontAttributes="Bold"
                        TextColor="#334155"
                        VerticalOptions="Center" />
                    <Button
                        Text="Search"
                        Command="{Binding SearchCommand}"
                        BackgroundColor="#0F766E"
                        TextColor="#FFFFFF" />
                    <Button
                        Text="Export CSV"
                        Command="{Binding ExportCsvCommand}"
                        BackgroundColor="#0F172A"
                        TextColor="#FFFFFF" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Padding="16"
            Stroke="#D8E0EA"
            StrokeThickness="1"
            BackgroundColor="#FFFFFF">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                    <Label Text="Serial #" Style="{StaticResource FieldLabel}" />
                    <Entry
                        Placeholder="Serial"
                        Text="{Binding SerialNumberFilter}"
                        Completed="OnFilterCompleted"
                        BackgroundColor="#F8FAFC"
                        PlaceholderColor="#94A3B8" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                    <Label Text="Board Type" Style="{StaticResource FieldLabel}" />
                    <Picker
                        ItemsSource="{Binding BoardTypes}"
                        SelectedItem="{Binding SelectedBoardTypeFilter}"
                        SelectedIndexChanged="OnFilterChanged"
                        BackgroundColor="#F8FAFC" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="6">
                    <Label Text="Date From" Style="{StaticResource FieldLabel}" />
                    <DatePicker
                        Date="{Binding DateFrom}"
                        BackgroundColor="#F8FAFC" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="0" Grid.Column="3" Spacing="6">
                    <Label Text="Date To" Style="{StaticResource FieldLabel}" />
                    <DatePicker
                        Date="{Binding DateTo}"
                        BackgroundColor="#F8FAFC" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                    <Label Text="Skid" Style="{StaticResource FieldLabel}" />
                    <Picker
                        ItemsSource="{Binding Skids}"
                        ItemDisplayBinding="{Binding SkidName}"
                        SelectedIndexChanged="OnFilterChanged"
                        SelectedItem="{Binding SelectedSkidFilter}"
                        BackgroundColor="#F8FAFC" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                    <Label Text="Shipped Status" Style="{StaticResource FieldLabel}" />
                    <Picker
                        ItemsSource="{Binding IsShippedOptions}"
                        SelectedItem="{Binding SelectedIsShippedOption}"
                        SelectedIndexChanged="OnFilterChanged"
                        BackgroundColor="#F8FAFC" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="6">
                    <Label Text="Imported Status" Style="{StaticResource FieldLabel}" />
                    <Picker
                        ItemsSource="{Binding IsImportedOptions}"
                        SelectedItem="{Binding SelectedIsImportedOption}"
                        SelectedIndexChanged="OnFilterChanged"
                        BackgroundColor="#F8FAFC" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Grid.Column="3" Spacing="6">
                    <Label Text="Date Mode" Style="{StaticResource FieldLabel}" />
                    <Button
                        Text="{Binding DateModeButtonText}"
                        Command="{Binding ToggleDateModeCommand}"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Stroke="#D8E0EA"
            StrokeThickness="1"
            BackgroundColor="#FFFFFF">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <ScrollView Orientation="Horizontal">
                <Grid WidthRequest="1180" RowDefinitions="Auto,*">
                    <Grid
                        Grid.Row="0"
                        Padding="12,10"
                        ColumnDefinitions="150,260,130,130,130,110,110,80"
                        ColumnSpacing="12"
                        BackgroundColor="#EAF0F6">
                        <Label Text="Serial" Style="{StaticResource HeaderCell}" />
                        <Label Grid.Column="1" Text="Part #" Style="{StaticResource HeaderCell}" />
                        <Label Grid.Column="2" Text="Type" Style="{StaticResource HeaderCell}" />
                        <Label Grid.Column="3" Text="Prep Date" Style="{StaticResource HeaderCell}" />
                        <Label Grid.Column="4" Text="Ship Date" Style="{StaticResource HeaderCell}" />
                        <Label Grid.Column="5" Text="Shipped" Style="{StaticResource HeaderCell}" />
                        <Label Grid.Column="6" Text="Imported" Style="{StaticResource HeaderCell}" />
                        <Label Grid.Column="7" Text="Skid" Style="{StaticResource HeaderCell}" />
                    </Grid>

                    <CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding Boards}"
                        VerticalOptions="FillAndExpand">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.EmptyView>
                            <Label Text="No boards found." Padding="14" TextColor="#64748B" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:BoardDto">
                                <Grid
                                    Padding="12,9"
                                    ColumnDefinitions="150,260,130,130,130,110,110,80"
                                    ColumnSpacing="12"
                                    BackgroundColor="#FFFFFF">
                                    <Label Text="{Binding SerialNumber}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="1" Text="{Binding PartNumber}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="2" Text="{Binding BoardType}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="3" Text="{Binding PrepDate, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="4" Text="{Binding ShipDate, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="5" Text="{Binding IsShipped}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="6" Text="{Binding IsImported}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="7" Text="{Binding SkidID}" Style="{StaticResource BodyCell}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </ScrollView>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Button
                Text="Previous"
                Command="{Binding PreviousPageCommand}"
                BackgroundColor="#E2E8F0"
                TextColor="#0F172A" />

            <Border
                Grid.Column="1"
                Padding="12,8"
                Stroke="#D8E0EA"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF"
                HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    Text="{Binding PageNumber}"
                    FontAttributes="Bold"
                    TextColor="#0F172A"
                    HorizontalTextAlignment="Center" />
            </Border>

            <Button
                Grid.Column="2"
                Text="Next"
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding HasNextPage}"
                BackgroundColor="#0F766E"
                TextColor="#FFFFFF" />
        </Grid>
    </Grid>
</ContentPage>
