<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PCBTracker.UI.Views.InspectionPage"
    Title="Inspection"
    BackgroundColor="#F4F7FA">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="HeaderCell" TargetType="Label">
            <Setter Property="TextColor" Value="#334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="BodyCell" TargetType="Label">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="PlaceholderColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
        <Style TargetType="Editor">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="PlaceholderColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="TitleColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Border Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Inspection" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Submit inspection notes, review past entries, and record assembly counts." TextColor="#64748B" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <Button Text="Add Inspection" Clicked="ToggleFormVisibility" BackgroundColor="#0F766E" TextColor="#FFFFFF" />
                <Button Grid.Column="1" Text="Past Inspections" Clicked="TogglePastInspectionVisibility" BackgroundColor="#0F172A" TextColor="#FFFFFF" />
                <Button Grid.Column="2" Text="Add Assembly Count" Clicked="ToggleAssemblyVisibility" BackgroundColor="#334155" TextColor="#FFFFFF" />
                <Button Grid.Column="3" Text="View Assembly Count" Clicked="ToggleAssemblyViewVisibility" BackgroundColor="#E2E8F0" TextColor="#0F172A" />
            </Grid>

            <Border x:Name="FormSection" IsVisible="False" Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Add Inspection" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Label Text="Date" Style="{StaticResource FieldLabel}" />
                            <DatePicker Date="{Binding Date}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                            <Label Text="Product / SKU" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding ProductType}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                            <Label Text="Product ID / SN" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding SerialNumber}" Placeholder="Scan or type barcode" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                            <Label Text="Severity Level" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding SeverityLevels}" SelectedItem="{Binding SeverityLevel}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="6">
                            <Label Text="Issue Description" Style="{StaticResource FieldLabel}" />
                            <Editor Text="{Binding IssueDescription}" AutoSize="TextChanges" HeightRequest="92" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="6">
                            <Label Text="Immediate Action Taken" Style="{StaticResource FieldLabel}" />
                            <Editor Text="{Binding ImmediateActionTaken}" AutoSize="TextChanges" HeightRequest="92" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="6">
                            <Label Text="Additional Notes" Style="{StaticResource FieldLabel}" />
                            <Editor Text="{Binding AdditionalNotes}" AutoSize="TextChanges" HeightRequest="80" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="Submit Inspection" Command="{Binding SubmitCommand}" BackgroundColor="#0F766E" TextColor="#FFFFFF" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="PastInspectionSection" IsVisible="False" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="14,12" ColumnDefinitions="*,Auto" BackgroundColor="#F8FAFC">
                        <Label Text="Past Inspections" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Text="Export CSV" Command="{Binding ExportCsvCommand}" BackgroundColor="#0F172A" TextColor="#FFFFFF" />
                    </Grid>
                    <ScrollView Orientation="Horizontal">
                        <Grid WidthRequest="1120" RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" Padding="12,10" ColumnDefinitions="140,180,170,120,260,250" ColumnSpacing="12" BackgroundColor="#EAF0F6">
                                <Label Text="Date" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="1" Text="Product Type" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="2" Text="Serial #" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="3" Text="Severity" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="4" Text="Issue" Style="{StaticResource HeaderCell}" />
                                <Label Grid.Column="5" Text="Action Taken" Style="{StaticResource HeaderCell}" />
                            </Grid>
                            <CollectionView Grid.Row="1" ItemsSource="{Binding Inspections}" HeightRequest="260">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,9" ColumnDefinitions="140,180,170,120,260,250" ColumnSpacing="12">
                                            <Label Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource BodyCell}" />
                                            <Label Grid.Column="1" Text="{Binding ProductType}" Style="{StaticResource BodyCell}" />
                                            <Label Grid.Column="2" Text="{Binding SerialNumber}" Style="{StaticResource BodyCell}" />
                                            <Label Grid.Column="3" Text="{Binding SeverityLevel}" Style="{StaticResource BodyCell}" />
                                            <Label Grid.Column="4" Text="{Binding IssueDescription}" Style="{StaticResource BodyCell}" />
                                            <Label Grid.Column="5" Text="{Binding ImmediateActionTaken}" Style="{StaticResource BodyCell}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="AssemblyCountSection" IsVisible="False" Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Assemblies Completed" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Date" Style="{StaticResource FieldLabel}" />
                            <DatePicker Date="{Binding AssemblyDate}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Board Type" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding AssemblyTypes}" SelectedItem="{Binding SelectedAssemblyType}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6">
                            <Label Text="Count" Style="{StaticResource FieldLabel}" />
                            <Entry Keyboard="Numeric" Placeholder="Count" Text="{Binding AssemblyCountText}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="Submit Assembly" Command="{Binding SubmitAssemblyCommand}" BackgroundColor="#0F766E" TextColor="#FFFFFF" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="AssemblyCountViewSection" IsVisible="False" Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Assembly Count" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="From" Style="{StaticResource FieldLabel}" />
                            <DatePicker Date="{Binding AssemblyFilterFrom}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="To" Style="{StaticResource FieldLabel}" />
                            <DatePicker Date="{Binding AssemblyFilterTo}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6">
                            <Label Text="Board Type" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding AssemblyTypes}" SelectedItem="{Binding SelectedAssemblyFilterType}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="3" Text="Filter" Command="{Binding LoadAssembliesCommand}" BackgroundColor="#0F766E" TextColor="#FFFFFF" VerticalOptions="End" />
                    </Grid>
                    <Grid Padding="12,10" ColumnDefinitions="160,240,120" ColumnSpacing="12" BackgroundColor="#EAF0F6">
                        <Label Text="Date" Style="{StaticResource HeaderCell}" />
                        <Label Grid.Column="1" Text="Board Type" Style="{StaticResource HeaderCell}" />
                        <Label Grid.Column="2" Text="Count" Style="{StaticResource HeaderCell}" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding SubmittedAssemblies}" HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,9" ColumnDefinitions="160,240,120" ColumnSpacing="12">
                                    <Label Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="1" Text="{Binding BoardType}" Style="{StaticResource BodyCell}" />
                                    <Label Grid.Column="2" Text="{Binding Count}" Style="{StaticResource BodyCell}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
