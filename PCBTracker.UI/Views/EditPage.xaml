<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:PCBTracker.Domain.DTOs;assembly=PCBTracker.Domain"
    x:Class="PCBTracker.UI.Views.EditPage"
    Title="Edit"
    BackgroundColor="#F4F7FA">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="HeaderCell" TargetType="Label">
            <Setter Property="TextColor" Value="#334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="BodyCell" TargetType="Label">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="PlaceholderColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="TitleColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Border Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Edit Boards" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="{Binding DateModeLabel}" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                        <Button Text="Search" Command="{Binding SearchCommand}" BackgroundColor="#0F766E" TextColor="#FFFFFF" />
                        <Button Text="Export CSV" Command="{Binding ExportCsvCommand}" BackgroundColor="#0F172A" TextColor="#FFFFFF" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <Border Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                        <Label Text="Serial #" Style="{StaticResource FieldLabel}" />
                        <Entry Placeholder="Serial" Text="{Binding SerialNumberFilter}" Completed="OnFilterCompleted" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                        <Label Text="Board Type" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding BoardTypes}" SelectedItem="{Binding SelectedBoardTypeFilter}" SelectedIndexChanged="OnFilterChanged" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="6">
                        <Label Text="Date From" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding DateFrom}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="3" Spacing="6">
                        <Label Text="Date To" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding DateTo}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                        <Label Text="Skid" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding Skids}" ItemDisplayBinding="{Binding SkidName}" SelectedIndexChanged="OnFilterChanged" SelectedItem="{Binding SelectedSkidFilter}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                        <Label Text="Shipped Status" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding IsShippedOptions}" SelectedItem="{Binding SelectedIsShippedOption}" SelectedIndexChanged="OnFilterChanged" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="6">
                        <Label Text="Imported Status" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding IsImportedOptions}" SelectedItem="{Binding SelectedIsImportedOption}" SelectedIndexChanged="OnFilterChanged" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="3" Spacing="6">
                        <Label Text="Date Mode" Style="{StaticResource FieldLabel}" />
                        <Button Text="{Binding DateModeButtonText}" Command="{Binding ToggleDateModeCommand}" BackgroundColor="#E2E8F0" TextColor="#0F172A" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border Grid.Column="0" Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Board Actions" Style="{StaticResource SectionTitle}" />
                        <Label Text="Remove Board" Style="{StaticResource FieldLabel}" />
                        <Entry Placeholder="Serial Number to Remove" Text="{Binding RemoveSerialNumber}" />
                        <Button Text="Remove Board" Command="{Binding RemoveBoardCommand}" BackgroundColor="#DC2626" TextColor="#FFFFFF" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Ship Dates" Style="{StaticResource SectionTitle}" />
                        <Label Text="Apply Ship Date to Skid" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding Skids}" SelectedItem="{Binding ApplyShipDateSkid}" ItemDisplayBinding="{Binding SkidName}" />
                        <DatePicker Date="{Binding NewShipDate}" />
                        <Button Text="Apply Ship Date" Command="{Binding ApplyShipDateToSkidCommand}" BackgroundColor="#0F766E" TextColor="#FFFFFF" />
                        <BoxView HeightRequest="1" Color="#E2E8F0" />
                        <Label Text="Clear Ship Date for Skid" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding Skids}" SelectedItem="{Binding ClearShipDateSkid}" ItemDisplayBinding="{Binding SkidName}" />
                        <Button Text="Clear Ship Date" Command="{Binding ClearShipDateForSkidCommand}" BackgroundColor="#E2E8F0" TextColor="#0F172A" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Import and Skid" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="Use Date" TextColor="#334155" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding UseImportDate}" />
                        </Grid>
                        <DatePicker Date="{Binding ImportTargetDate}" IsEnabled="{Binding UseImportDate}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="Use Skid" TextColor="#334155" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding UseImportSkid}" />
                        </Grid>
                        <Picker ItemsSource="{Binding Skids}" SelectedItem="{Binding ImportTargetSkid}" ItemDisplayBinding="{Binding SkidName}" IsEnabled="{Binding UseImportSkid}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="Set to Imported" TextColor="#334155" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ImportFlag}" />
                        </Grid>
                        <Button Text="Apply Imported Flag" Command="{Binding ApplyImportFlagCommand}" BackgroundColor="#0F766E" TextColor="#FFFFFF" />
                        <BoxView HeightRequest="1" Color="#E2E8F0" />
                        <Label Text="Delete All Boards on Skid" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding Skids}" SelectedItem="{Binding DeleteSkidTarget}" ItemDisplayBinding="{Binding SkidName}" />
                        <Button Text="Delete Skid Boards" Command="{Binding DeleteSkidCommand}" BackgroundColor="#B91C1C" TextColor="#FFFFFF" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <ScrollView Orientation="Horizontal">
                    <Grid WidthRequest="1180" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Padding="12,10" ColumnDefinitions="150,260,130,130,130,110,110,80" ColumnSpacing="12" BackgroundColor="#EAF0F6">
                            <Label Text="Serial" Style="{StaticResource HeaderCell}" />
                            <Label Grid.Column="1" Text="Part #" Style="{StaticResource HeaderCell}" />
                            <Label Grid.Column="2" Text="Type" Style="{StaticResource HeaderCell}" />
                            <Label Grid.Column="3" Text="Prep Date" Style="{StaticResource HeaderCell}" />
                            <Label Grid.Column="4" Text="Ship Date" Style="{StaticResource HeaderCell}" />
                            <Label Grid.Column="5" Text="Shipped" Style="{StaticResource HeaderCell}" />
                            <Label Grid.Column="6" Text="Imported" Style="{StaticResource HeaderCell}" />
                            <Label Grid.Column="7" Text="Skid" Style="{StaticResource HeaderCell}" />
                        </Grid>
                        <CollectionView Grid.Row="1" ItemsSource="{Binding Boards}" HeightRequest="340">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:BoardDto">
                                    <Grid Padding="12,9" ColumnDefinitions="150,260,130,130,130,110,110,80" ColumnSpacing="12">
                                        <Label Text="{Binding SerialNumber}" Style="{StaticResource BodyCell}" />
                                        <Label Grid.Column="1" Text="{Binding PartNumber}" Style="{StaticResource BodyCell}" />
                                        <Label Grid.Column="2" Text="{Binding BoardType}" Style="{StaticResource BodyCell}" />
                                        <Label Grid.Column="3" Text="{Binding PrepDate, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource BodyCell}" />
                                        <Label Grid.Column="4" Text="{Binding ShipDate, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource BodyCell}" />
                                        <Label Grid.Column="5" Text="{Binding IsShipped}" Style="{StaticResource BodyCell}" />
                                        <Label Grid.Column="6" Text="{Binding IsImported}" Style="{StaticResource BodyCell}" />
                                        <Label Grid.Column="7" Text="{Binding SkidID}" Style="{StaticResource BodyCell}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </ScrollView>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Button Text="Previous" Command="{Binding PreviousPageCommand}" BackgroundColor="#E2E8F0" TextColor="#0F172A" />
                <Label Grid.Column="1" Text="{Binding PageNumber}" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" BackgroundColor="#0F766E" TextColor="#FFFFFF" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
