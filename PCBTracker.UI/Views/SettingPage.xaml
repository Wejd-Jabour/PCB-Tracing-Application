<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PCBTracker.UI.Views.SettingPage"
    Title="Settings"
    BackgroundColor="#F4F7FA">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="PlaceholderColor" Value="#64748B" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Border Padding="16" Stroke="#D8E0EA" StrokeThickness="1" BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Settings" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Create users, update permissions, and remove inactive accounts." TextColor="#64748B" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Text="Add New User" Clicked="ToggleUserCreateVisibility" BackgroundColor="#0F766E" TextColor="#FFFFFF" />
                <Button Grid.Column="1" Text="Update Permissions" Clicked="TogglePermissionUpdateVisibility" BackgroundColor="#0F172A" TextColor="#FFFFFF" />
                <Button Grid.Column="2" Text="Remove User" Clicked="ToggleUserRemoveVisibility" BackgroundColor="#DC2626" TextColor="#FFFFFF" />
            </Grid>

            <Border
                x:Name="UserCreateSection"
                IsVisible="{Binding IsUserCreateSectionVisible}"
                Padding="16"
                Stroke="#D8E0EA"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Create User" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Label Text="Employee ID" Style="{StaticResource FieldLabel}" />
                            <Entry Placeholder="Employee ID" Keyboard="Numeric" Text="{Binding NewEmployeeIDText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                            <Label Text="Username" Style="{StaticResource FieldLabel}" />
                            <Entry Placeholder="Username" Text="{Binding NewUsername}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="6">
                            <Label Text="Password" Style="{StaticResource FieldLabel}" />
                            <Entry Placeholder="Password" Text="{Binding NewPassword}" IsPassword="True" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="3" Spacing="6">
                            <Label Text="First Name" Style="{StaticResource FieldLabel}" />
                            <Entry Placeholder="First Name" Text="{Binding NewFirstName}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="4" Spacing="6">
                            <Label Text="Last Name" Style="{StaticResource FieldLabel}" />
                            <Entry Placeholder="Last Name" Text="{Binding NewLastName}" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="1" Grid.ColumnSpan="5" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12" Padding="0,4,0,0">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                <Switch IsToggled="{Binding AdminPermission}" />
                                <Label Text="Admin" TextColor="#334155" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Switch IsToggled="{Binding ScanPermission}" />
                                <Label Text="Scan" TextColor="#334155" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="8">
                                <Switch IsToggled="{Binding ExtractPermission}" />
                                <Label Text="Extract" TextColor="#334155" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="3" Spacing="8">
                                <Switch IsToggled="{Binding EditPermission}" />
                                <Label Text="Edit" TextColor="#334155" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="4" Spacing="8">
                                <Switch IsToggled="{Binding CoordinatorPermission}" />
                                <Label Text="Coordinator" TextColor="#334155" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Grid>
                    <Button Text="Create New User" Command="{Binding CreateNewUserCommand}" BackgroundColor="#0F766E" TextColor="#FFFFFF" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="PermissionUpdateSection"
                IsVisible="{Binding IsPermissionUpdateSectionVisible}"
                Padding="16"
                Stroke="#D8E0EA"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Update Permissions" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="220,*,*,*,*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Label Text="Employee ID" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding UpdateEmployeeIDText}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                            <Label Text="Username" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding UpdateUsername}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                            <CheckBox IsChecked="{Binding UpdateAdminPermission}" />
                            <Label Text="Admin" TextColor="#334155" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8">
                            <CheckBox IsChecked="{Binding UpdateScanPermission}" />
                            <Label Text="Scan" TextColor="#334155" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="2" Spacing="8">
                            <CheckBox IsChecked="{Binding UpdateExtractPermission}" />
                            <Label Text="Extract" TextColor="#334155" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="3" Spacing="8">
                            <CheckBox IsChecked="{Binding UpdateEditPermission}" />
                            <Label Text="Edit" TextColor="#334155" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="4" Spacing="8">
                            <CheckBox IsChecked="{Binding UpdateCoordinatorPermission}" />
                            <Label Text="Coordinator" TextColor="#334155" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Button Text="Save Changes" Command="{Binding UpdateUserPermissionsCommand}" BackgroundColor="#0F766E" TextColor="#FFFFFF" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="UserRemoveSection"
                IsVisible="{Binding IsUserRemoveSectionVisible}"
                Padding="16"
                Stroke="#FECACA"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Remove User" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Employee ID" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding RemoveEmployeeIDText}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Username" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding RemoveUsername}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="Confirm Removal" Command="{Binding RemoveUserCommand}" BackgroundColor="#DC2626" TextColor="#FFFFFF" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
